# Language layer. Copy to .env and fill locally. Never commit .env.
# The current implementation reads DEEPSEEK_* at runtime.
# RADARMIND_LLM_API_KEY is accepted as an alias for DEEPSEEK_API_KEY.

RADARMIND_LLM_PROVIDER=deepseek
RADARMIND_LLM_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=30
DEEPSEEK_RETRIES=2

# Set to 1 to force template explanations without calling the provider.
RADARMIND_OFFLINE_DEMO=0

# Streamlit port for the research application.
RADARMIND_PORT=8502

# Optional rebuild paths. Used only when re-extracting or re-caching source data.
# CI4R_RAW_ZIP=
# RADARMIND_CI4R_ZIP=
# RADARMIND_MRI_ROOT=
# RADARMIND_RADHAR_ROOT=
# RADARMIND_SPLIT_DIR=
# RADARMIND_R2V_CACHE=
